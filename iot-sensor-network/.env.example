# Copy this file to .env and fill in your values before running any script.
# NEVER commit .env to Git — it is already listed in .gitignore.

# MySQL connection (used by VM1, VM2 sensors as DB fallback, and VM3 API server)
DB_HOST=192.168.56.103
DB_USER=iot_user
DB_PASSWORD=your_secure_password_here
DB_NAME=iot_db

# API server URL (used by VM1 and VM2 to send readings)
# Default points to VM3. Change if your network config differs.
API_URL=http://192.168.56.103:5000/api/measurements
